{
  "name": "hebrew-token-saver",
  "version": "1.0.0",
  "description": "Cross-platform skill that auto-translates Hebrew prompts to English and requests Hebrew responses",
  "main": "hebrew-translator.js",
  "bin": {
    "hebrew-translate": "./hebrew-translator.js",
    "hebrew-translate-hybrid": "./hebrew-translator-hybrid.js",
    "hebrew-translator-mcp": "./dist/hebrew-translator-mcp.js"
  },
  "scripts": {
    "bundle": "npx esbuild hebrew-translator-mcp-server.mjs --bundle --platform=node --target=node14 --external:@xenova/transformers --outfile=dist/hebrew-translator-mcp.js --banner:js=\"#!/usr/bin/env node\"",
    "postinstall": "npm run bundle && node install-claude.js",
    "install-opencode": "node install-opencode.js",
    "install-claude": "node install-claude.js",
    "test": "node test.js",
    "test-rtl": "node test-rtl.js",
    "demo": "node hebrew-translator.js 'איך מכינים חלבה?'",
    "demo-hybrid": "node hebrew-translator-hybrid.js 'איך מכינים חלבה?'"
  },
  "keywords": [
    "hebrew",
    "translation",
    "skill",
    "pi.dev",
    "claudecode",
    "opencode",
    "llm",
    "prompt"
  ],
  "author": "Hebrew Token Saver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sysmesh/hebrew-token-saver.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2"
  }
}
